# ======================
# SERVER CONFIGURATION
# ======================
NODE_ENV=development
PORT=5000

# ======================
# DATABASE
# ======================
MONGODB_URI=mongodb://localhost:27017/mental_wellness

# ======================
# AUTH / SECURITY
# ======================
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRE=15m
REFRESH_TTL_DAYS=7
# Set to false only for plain-http local development (the refresh cookie is Secure by default)
COOKIE_SECURE=true
# 32 random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Keep it OUTSIDE the database.
FIELD_ENCRYPTION_KEY=
JOURNAL_RETENTION_DAYS=180
# Brute-force control on credential endpoints
AUTH_RATE_MAX=5
AUTH_RATE_WINDOW_MS=900000
# Set when the API sits behind a reverse proxy / load balancer (TLS terminates there)
TRUST_PROXY=

# ======================
# NLP RECOMMENDER SERVICE (Python FastAPI, private network)
# ======================
NLP_SERVICE_URL=http://127.0.0.1:8001
NLP_SERVICE_KEY=

# ======================
# EMAIL (Nodemailer + Gmail SMTP)
# ======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@mentalwellness.com

# ======================
# CLIENT
# ======================
CLIENT_URL=http://localhost:5173

# ======================
# RATE LIMITING
# ======================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ======================
# AI INTEGRATION
# ======================
GROQ_API_KEY=your_groq_api_key_here
